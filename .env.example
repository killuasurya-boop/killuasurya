# Copy to .env.local (never commit .env.local). Leave empty to run in DEMO MODE.
# Supabase → Project Settings → API. Both values are public by design; do NOT put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site address used for sitemap / Open Graph.
NEXT_PUBLIC_SITE_URL=https://killuasurya.tech
# Optional: random string used to hash sender IPs for lead rate limiting (server only).
LEAD_HASH_SALT=
